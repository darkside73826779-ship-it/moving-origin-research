    "injection": {"type": "object", "additionalProperties": false, "required": ["case_id", "mutation_sha256", "expected_code", "observed_code", "pass"], "properties": {"case_id": {"type": "string"}, "mutation_sha256": {"$ref": "#/$defs/sha256"}, "expected_code": {"type": "string"}, "observed_code": {"type": "string"}, "pass": {"const": true}}}
