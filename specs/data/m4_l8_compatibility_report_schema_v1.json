  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "regime", "mode", "implementation_sha", "implementation_review_sha", "binding_manifest_sha256", "fixture_sha256", "expected_responses_sha256", "runs", "failure_injections", "repeat_payloads_equal", "failure", "verdict"],
  "properties": {
