782260109249e3e49873e7628"}, "expected_code": {"const": "UNSUPPORTED_OPERATION"}, "observed_code": {"const": "UNSUPPORTED_OPERATION"}}}], "items": false}, "repeat_payloads_equal": {"const": true}, "failure": {"type": "null"}}}},
    {"if": {"properties": {"verdict": {"const": "INSTRUMENT_FAILURE"}}, "required": ["verdict"]}, "then": {"properties": {"failure": {"type": "object"}}}}
