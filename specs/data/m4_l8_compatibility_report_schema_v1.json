    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["row_ordinal", "case_kind", "case_id", "expected_response_sha256", "observed", "observed_response_sha256", "pass"],
      "properties": {"row_ordinal": {"type": "integer", "minimum": 0, "maximum": 12}, "case_kind": {"enum": ["rho", "complete_verdict", "tie"]}, "case_id": {"type": "string"}, "expected_response_sha256": {"$ref": "#/$defs/sha256"}, "observed": {"type": "object"}, "observed_response_sha256": {"$ref": "#/$defs/sha256"}, "pass": {"const": true}},
      "allOf": [
        {"if": {"properties": {"case_kind": {"const": "rho"}}}, "then": {"properties": {"observed": {"$ref": "#/$defs/rho_observed"}}}},
        {"if": {"properties": {"case_kind": {"const": "complete_verdict"}}}, "then": {"properties": {"observed": {"$ref": "#/$defs/complete_observed"}}}},
        {"if": {"properties": {"case_kind": {"const": "tie"}}}, "then": {"properties": {"observed": {"$ref": "#/$defs/tie_observed"}}}}
      ]
    },
    "run": {
      "type": "object", "additionalProperties": false, "required": ["run_ordinal", "payload_sha256", "rows"],
      "properties": {
        "run_ordinal": {"enum": [0, 1]}, "payload_sha256": {"const": "62ce5b736a280d6c196e8ef4bfd77f254dff00f57bec880b95becd1938155d22"},
        "rows": {"type": "array", "minItems": 13, "maxItems": 13, "prefixItems": [
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 0}, "case_kind": {"const": "rho"}, "case_id": {"const": "perfect_increasing"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 1}, "case_kind": {"const": "rho"}, "case_id": {"const": "adjacent_inversion_threshold"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 2}, "case_kind": {"const": "rho"}, "case_id": {"const": "no_softening"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 3}, "case_kind": {"const": "rho"}, "case_id": {"const": "tied_responses"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 4}, "case_kind": {"const": "rho"}, "case_id": {"const": "constant_responses"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 5}, "case_kind": {"const": "rho"}, "case_id": {"const": "decreasing_responses"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 6}, "case_kind": {"const": "rho"}, "case_id": {"const": "nonfinite_without_apparatus_fault"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 7}, "case_kind": {"const": "complete_verdict"}, "case_id": {"const": "all_pass"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 8}, "case_kind": {"const": "complete_verdict"}, "case_id": {"const": "beta_failure"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 9}, "case_kind": {"const": "complete_verdict"}, "case_id": {"const": "undefined_rho"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 10}, "case_kind": {"const": "complete_verdict"}, "case_id": {"const": "rho_failure"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 11}, "case_kind": {"const": "tie"}, "case_id": {"const": "lower_clip_cutoff"}}},
          {"$ref": "#/$defs/row", "properties": {"row_ordinal": {"const": 12}, "case_kind": {"const": "tie"}, "case_id": {"const": "upper_clip_cutoff"}}}
        ], "items": false}
