{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://moving-origin-research.invalid/schemas/m4-harness-result-v1",
    "title": "M4 Harness Result v1",
    "x-artifact-date": "2026-08-21",
    "x-artifact-regime": "B",
    "x-source-class": "PROPOSED",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "date",
        "regime",
        "mode",
        "header",
        "preflight",
        "compatibility",
        "laws",
        "gates",
        "failure",
        "verdict"
    ],
    "properties": {
        "schema_version": {
            "const": "m4-harness-result-v1"
        },
        "date": {
            "type": "string",
            "format": "date"
        },
        "regime": {
            "const": "B"
        },
        "mode": {
            "enum": [
                "O-15-diagnostic-only",
                "SCORING"
            ]
        },
        "header": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "implementation_sha",
                "config_sha256",
                "binding_manifest_sha256",
                "dependency_manifest_sha256"
            ],
            "properties": {
                "implementation_sha": {
                    "$ref": "#/$defs/sha"
                },
                "config_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "binding_manifest_sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "dependency_manifest_sha256": {
                    "$ref": "#/$defs/sha256"
                }
            }
        },
        "preflight": {
            "enum": [
                "PASS",
                "INSTRUMENT_FAILURE"
            ]
        },
        "compatibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "report_path",
                "sha256",
                "verdict"
            ],
            "properties": {
                "report_path": {
                    "const": "diagnostics/m4_l8_compatibility_report.json"
                },
                "sha256": {
                    "$ref": "#/$defs/sha256"
                },
                "verdict": {
                    "enum": [
                        "COMPATIBLE_FOR_M4_O15",
                        "INSTRUMENT_FAILURE"
                    ]
                }
            }
        },
        "laws": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "law",
                    "status",
                    "artifact_path",
                    "artifact_sha256"
                ],
                "properties": {
                    "law": {
                        "enum": [
                            "L7",
                            "L8",
                            "L10",
                            "L14",
                            "L18"
                        ]
                    },
                    "status": {
                        "enum": [
                            "PASS",
                            "KILL",
                            "INSTRUMENT_FAILURE",
                            "NOT_RUN"
                        ]
                    },
                    "artifact_path": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "artifact_sha256": {
                        "anyOf": [
                            {
                                "$ref": "#/$defs/sha256"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                }
            }
        },
        "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "l3_fresh_seed_resolution",
                "fwfp_closure",
                "implementation_review",
                "rebecca_tolerance_calibration_signoff",
                "rebecca_courier_scoring_authorization"
            ],
            "properties": {
                "l3_fresh_seed_resolution": {
                    "type": "boolean"
                },
                "fwfp_closure": {
                    "type": "boolean"
                },
                "implementation_review": {
                    "type": "boolean"
                },
                "rebecca_tolerance_calibration_signoff": {
                    "type": "boolean"
                },
                "rebecca_courier_scoring_authorization": {
                    "type": "boolean"
                }
            }
        },
        "failure": {
            "anyOf": [
                {
                    "type": "null"
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "stage",
                        "message_code"
                    ],
                    "properties": {
                        "stage": {
                            "enum": [
                                "preflight",
                            "model_executor",
                            "device_to_host",
                            "producer_cpu",
                            "l8_adapter_parallel_cpu",
                                "estimator",
                                "law_aggregator",
                                "compatibility",
                                "custody",
                                "publisher"
                            ]
                        },
                        "message_code": {
                            "enum": [
                            "M4_CPU_L8_BINDING_UNRECONCILED",
                                "UNAPPROVED_IMPLEMENTATION_IDENTITY",
                                "SCHEMA_DRIFT",
                                "DIGEST_MISMATCH",
                                "DEPENDENCY_MISMATCH",
                                "CONFIGURATION_MISMATCH",
                                "LAW_IDENTITY_ORDER_MISMATCH",
                            "AI_CUDA_UNAVAILABLE",
                            "AI_GPU_ALLOCATION_FAILED",
                            "DEVICE_TRANSFER_FAILED",
                            "DEVICE_SYNCHRONIZATION_FAILED",
                            "NONDETERMINISTIC_HOST_EXPORT",
                            "UNAPPROVED_L8_BACKEND",
                            "PARALLEL_CPU_WORKER_FAILURE",
                                "UNSUPPORTED_OPERATION",
                                "NONFINITE_APPARATUS",
                                "NONDETERMINISTIC_RESPONSE",
                                "SEED_CUSTODY_FAILURE",
                                "PUBLICATION_INTERRUPTED"
                            ]
                        }
                    }
                }
            ]
        },
        "verdict": {
            "enum": [
                "PASS",
                "KILL",
                "INSTRUMENT_FAILURE",
                "DIAGNOSTIC_ONLY"
            ]
        }
    },
    "$defs": {
        "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
        },
        "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        }
    }
}
