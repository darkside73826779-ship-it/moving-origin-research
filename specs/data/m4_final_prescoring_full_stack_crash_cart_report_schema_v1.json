        "output_token_count": {"type": "integer", "minimum": 0}, "stop_reason": {"type": "string", "minLength": 1},
        "start_monotonic_ns": {"type": "integer", "minimum": 0}, "end_monotonic_ns": {"type": "integer", "minimum": 0},
        "latency_ns": {"type": "integer", "minimum": 0, "maximum": 30000000000}, "completion_status": {"enum": ["PASS", "FAIL"]},
        "error_code": {"type": ["string", "null"]}, "retry_count": {"const": 0}
      }
    },
    "warmupRow": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "payload_bytes", "max_output_tokens", "prompt_text", "prompt_bytes", "prompt_sha256", "barrier_release_monotonic_ns", "candidate", "peer", "same_prompt_and_parameters", "content_interpreted", "status"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 3}, "payload_bytes": {"enum": [0,32,512,1024]},
        "max_output_tokens": {"enum": [8,16,32]}, "prompt_text": {"type": "string", "minLength": 1}, "prompt_bytes": {"enum": [94,127,608,1121]},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}, "barrier_release_monotonic_ns": {"type": "integer", "minimum": 0},
        "candidate": {"$ref": "#/$defs/warmupRoleObservation"}, "peer": {"$ref": "#/$defs/warmupRoleObservation"},
        "same_prompt_and_parameters": {"const": true}, "content_interpreted": {"const": false}, "status": {"enum": ["PASS", "FAIL"]}
      }
    },
    "roleObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "runtime_instance_id", "request_id", "receipt_id", "backend_receipt", "session_sha256", "pre_state_sha256", "post_state_sha256", "private_view_sha256", "output_text", "output_sha256", "input_token_count", "output_token_count", "stop_reason", "start_monotonic_ns", "end_monotonic_ns", "latency_ns", "backend_status", "error_code", "retry_count", "lifecycle_trace_sha256", "rollback_trace_sha256"],
      "properties": {
        "role": {"enum": ["candidate", "peer"]}, "runtime_instance_id": {"type": "string", "minLength": 1},
        "request_id": {"type": "string", "minLength": 1}, "receipt_id": {"type": "string", "minLength": 1},
        "backend_receipt": {"$ref": "#/$defs/backendReceipt"},
        "session_sha256": {"$ref": "#/$defs/sha256"}, "pre_state_sha256": {"$ref": "#/$defs/sha256"}, "post_state_sha256": {"$ref": "#/$defs/sha256"},
        "private_view_sha256": {"$ref": "#/$defs/sha256"}, "output_text": {"type": "string"}, "output_sha256": {"$ref": "#/$defs/sha256"},
        "input_token_count": {"type": "integer", "minimum": 1}, "output_token_count": {"type": "integer", "minimum": 0},
        "stop_reason": {"type": "string", "minLength": 1}, "start_monotonic_ns": {"type": "integer", "minimum": 0},
        "end_monotonic_ns": {"type": "integer", "minimum": 0}, "latency_ns": {"type": "integer", "minimum": 0},
        "backend_status": {"enum": ["PASS", "FAIL"]}, "error_code": {"type": ["string", "null"]}, "retry_count": {"const": 0},
        "lifecycle_trace_sha256": {"$ref": "#/$defs/sha256"}, "rollback_trace_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "backendReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "backend_code", "session_id", "prior_backend_state_sha256", "result_backend_state_sha256", "request_sha256", "request_ordinal"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]}, "backend_code": {"type": ["string", "null"]}, "session_id": {"type": "string", "minLength": 1},
        "prior_backend_state_sha256": {"$ref": "#/$defs/sha256"}, "result_backend_state_sha256": {"$ref": "#/$defs/sha256"},
        "request_sha256": {"$ref": "#/$defs/sha256"}, "request_ordinal": {"type": "integer", "minimum": 1}
      }
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "fixture_family", "fixture_repetition", "payload_bytes", "scheduled_offset_ns", "actual_enqueue_ns", "producer_block_ns", "public_prompt_text", "prompt_sha256", "candidate", "peer", "pair_completion_ordinal", "outputs_equal", "pair_status"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 63}, "fixture_family": {"type": "integer", "minimum": 0, "maximum": 7},
        "fixture_repetition": {"type": "integer", "minimum": 0, "maximum": 7}, "payload_bytes": {"enum": [0,32,64,128,256,512,768,1024]},
        "scheduled_offset_ns": {"type": "integer", "minimum": 0, "maximum": 30000000000}, "actual_enqueue_ns": {"type": "integer", "minimum": 0},
        "producer_block_ns": {"type": "integer", "minimum": 0}, "public_prompt_text": {"type": "string", "minLength": 1},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}, "candidate": {"$ref": "#/$defs/roleObservation"}, "peer": {"$ref": "#/$defs/roleObservation"},
        "pair_completion_ordinal": {"type": "integer", "minimum": 0, "maximum": 63}, "outputs_equal": {"type": "boolean"},
        "pair_status": {"enum": ["COMPLETE", "FAILED_RETAINED"]}
      }
