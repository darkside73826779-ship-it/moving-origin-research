    "resourceSample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_index", "monotonic_ns", "gpu_utilization_percent", "gpu_memory_used_bytes", "candidate_process_gpu_bytes", "peer_process_gpu_bytes", "host_ram_used_bytes", "candidate_rss_bytes", "peer_rss_bytes", "queue_depth_pairs", "producer_blocked", "completed_pair_count"],
