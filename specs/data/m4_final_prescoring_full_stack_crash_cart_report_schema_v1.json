{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moving-origin-research.invalid/schemas/m4-final-prescoring-full-stack-crash-cart-report-v1",
  "title": "M4 final pre-scoring full-stack crash-cart report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "date", "regime", "classification", "identities", "invocation", "negative_probes", "warmup", "active_window", "rows", "resource_samples", "trends", "laws", "structural_status", "structural_failures", "replica_consistency", "cleanup", "public_safety", "export"],
  "properties": {
    "schema_version": {"const": "m4-final-prescoring-full-stack-crash-cart-report-v1"},
    "date": {"type": "string", "format": "date"},
    "regime": {"const": "B"},
    "classification": {"const": "NON_SCORING_EXPLORATORY_OBSERVATION"},
    "identities": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 12},
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["release_sha", "command_sha256", "invocation_count", "retry_count", "network", "protected_inputs_accessed", "scoring_enabled"],
      "properties": {
        "release_sha": {"$ref": "#/$defs/sha"}, "command_sha256": {"$ref": "#/$defs/sha256"},
        "invocation_count": {"const": 1}, "retry_count": {"const": 0}, "network": {"const": "NONE_OS_ENFORCED"},
        "protected_inputs_accessed": {"const": false}, "scoring_enabled": {"const": false}
      }
    },
    "negative_probes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/negativeProbe"}},
    "warmup": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "rows", "sequence_start_monotonic_ns", "sequence_end_monotonic_ns", "sequence_duration_ns", "first_pair_latency_ns", "subsequent_pair_latencies_ns", "candidate_peak_gpu_bytes", "peer_peak_gpu_bytes", "barrier_start_monotonic_ns", "barrier_end_monotonic_ns", "barrier_duration_ns", "zero_active_requests", "prefix_cache_disabled", "residual_session_state", "residual_reusable_kv_state", "measured_rng_initialized_after_barrier", "status"],
      "properties": {
        "classification": {"const": "NON_SCORING_OPERATIONAL_WARMUP"},
        "rows": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/warmupRow"}},
        "sequence_start_monotonic_ns": {"type": "integer", "minimum": 0}, "sequence_end_monotonic_ns": {"type": "integer", "minimum": 0},
        "sequence_duration_ns": {"type": "integer", "minimum": 0, "maximum": 120000000000}, "first_pair_latency_ns": {"type": "integer", "minimum": 0, "maximum": 30000000000},
        "subsequent_pair_latencies_ns": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 30000000000}},
        "candidate_peak_gpu_bytes": {"type": "integer", "minimum": 0}, "peer_peak_gpu_bytes": {"type": "integer", "minimum": 0},
        "barrier_start_monotonic_ns": {"type": "integer", "minimum": 0}, "barrier_end_monotonic_ns": {"type": "integer", "minimum": 0},
        "barrier_duration_ns": {"type": "integer", "minimum": 0, "maximum": 10000000000}, "zero_active_requests": {"const": true},
        "prefix_cache_disabled": {"const": true}, "residual_session_state": {"const": false}, "residual_reusable_kv_state": {"const": false},
        "measured_rng_initialized_after_barrier": {"const": true}, "status": {"enum": ["PASS", "FAIL"]}
      }
    },
    "active_window": {
      "type": "object", "additionalProperties": false,
      "required": ["start_monotonic_ns", "end_monotonic_ns", "duration_ns", "deadline_ns", "paired_request_count", "role_request_count", "queue_capacity_pairs", "drop_count", "fifo", "producer_block_event_count", "producer_block_total_ns"],
      "properties": {
        "start_monotonic_ns": {"type": "integer", "minimum": 0}, "end_monotonic_ns": {"type": "integer", "minimum": 0},
        "duration_ns": {"type": "integer", "minimum": 30000000000, "maximum": 60000000000}, "deadline_ns": {"const": 60000000000},
        "paired_request_count": {"const": 64}, "role_request_count": {"const": 128}, "queue_capacity_pairs": {"const": 8},
        "drop_count": {"const": 0}, "fifo": {"const": true}, "producer_block_event_count": {"type": "integer", "minimum": 1},
        "producer_block_total_ns": {"type": "integer", "minimum": 1}
      }
    },
    "rows": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"$ref": "#/$defs/row"}},
    "resource_samples": {"type": "array", "minItems": 121, "items": {"$ref": "#/$defs/resourceSample"}},
    "trends": {"$ref": "#/$defs/trends"},
    "laws": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/law"}},
    "structural_status": {"enum": ["PASS", "BLOCKED", "INSTRUMENT_FAILURE"]},
    "structural_failures": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "replica_consistency": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "compared_count", "agreement_count", "mismatch_count", "mismatch_ordinals", "exact_replica_consumer_stop"],
      "properties": {
        "status": {"enum": ["MATCH", "MISMATCH", "NOT_RUN"]}, "compared_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "agreement_count": {"type": "integer", "minimum": 0, "maximum": 64}, "mismatch_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "mismatch_ordinals": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 63}, "uniqueItems": true},
        "exact_replica_consumer_stop": {"type": "boolean"}
      }
    },
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_engine_disposed", "peer_engine_disposed", "candidate_process_absent", "peer_process_absent", "backend_owned_gpu_allocations", "temp_file_count", "repository_clean", "terminal_sample_index", "status"],
      "properties": {
        "candidate_engine_disposed": {"type": "boolean"}, "peer_engine_disposed": {"type": "boolean"},
        "candidate_process_absent": {"type": "boolean"}, "peer_process_absent": {"type": "boolean"},
        "backend_owned_gpu_allocations": {"type": "integer", "minimum": 0}, "temp_file_count": {"type": "integer", "minimum": 0},
        "repository_clean": {"type": "boolean"}, "terminal_sample_index": {"type": "integer", "minimum": 0},
        "status": {"enum": ["PASS", "FAIL"]}
      }
    },
    "public_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["scanner_status", "finding_count", "classified_count", "suppressed_count", "row_deletion_count", "private_values_found", "protected_inputs_found", "token_arrays_found"],
      "properties": {
        "scanner_status": {"enum": ["CLEAR", "BLOCKED_PUBLIC_SAFETY"]}, "finding_count": {"type": "integer", "minimum": 0},
        "classified_count": {"type": "integer", "minimum": 0}, "suppressed_count": {"const": 0}, "row_deletion_count": {"const": 0},
        "private_values_found": {"const": false}, "protected_inputs_found": {"const": false}, "token_arrays_found": {"const": false}
      }
    },
    "export": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "report_bytes", "report_sha256", "summary_bytes", "summary_sha256", "manifest_bytes", "manifest_sha256", "archive_bytes", "archive_sha256", "reproduction_equal"],
      "properties": {
        "status": {"enum": ["EXPORTED", "BLOCKED_PUBLIC_SAFETY", "NOT_RENDERED_INSTRUMENT_FAILURE"]},
        "report_bytes": {"type": "integer", "minimum": 1}, "report_sha256": {"$ref": "#/$defs/sha256"},
