        "manifest_bytes": {"type": "integer", "minimum": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "archive_bytes": {"type": ["integer", "null"], "minimum": 1}, "archive_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "reproduction_equal": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "negativeProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "id", "expected", "observed", "model_call_count", "retry_count", "pre_state_sha256", "post_state_sha256", "pre_stage_sha256", "post_stage_sha256", "status"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 2}, "id": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1}, "observed": {"type": "string", "minLength": 1},
        "model_call_count": {"const": 0}, "retry_count": {"const": 0},
        "pre_state_sha256": {"$ref": "#/$defs/sha256"}, "post_state_sha256": {"$ref": "#/$defs/sha256"},
        "pre_stage_sha256": {"$ref": "#/$defs/sha256"}, "post_stage_sha256": {"$ref": "#/$defs/sha256"},
