        "gpu_utilization_percent": {"type": "number", "minimum": 0, "maximum": 100}, "gpu_memory_used_bytes": {"type": "integer", "minimum": 0},
        "candidate_process_gpu_bytes": {"type": "integer", "minimum": 0}, "peer_process_gpu_bytes": {"type": "integer", "minimum": 0},
        "host_ram_used_bytes": {"type": "integer", "minimum": 0}, "candidate_rss_bytes": {"type": "integer", "minimum": 0},
        "peer_rss_bytes": {"type": "integer", "minimum": 0}, "queue_depth_pairs": {"type": "integer", "minimum": 0, "maximum": 8},
        "producer_blocked": {"type": "boolean"}, "completed_pair_count": {"type": "integer", "minimum": 0, "maximum": 64}
      }
    },
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["count", "min", "mean", "p50", "p90", "p95", "max"],
      "properties": {"count": {"type": "integer", "minimum": 0}, "min": {"type": "number"}, "mean": {"type": "number"}, "p50": {"type": "number"}, "p90": {"type": "number"}, "p95": {"type": "number"}, "max": {"type": "number"}}
    },
    "trends": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "candidate_latency_ns", "peer_latency_ns", "candidate_output_tokens", "peer_output_tokens", "throughput_one_second_bins", "resource_sample_count", "queue_block_ns", "agreement_count", "disagreement_ordinals", "fixture_stability", "stop_counts", "error_counts", "lexical_refusal_marker_counts", "context_buckets", "decision_use"],
      "properties": {
        "classification": {"const": "NON_SCORING_EXPLORATORY_OBSERVATION"},
        "candidate_latency_ns": {"$ref": "#/$defs/distribution"}, "peer_latency_ns": {"$ref": "#/$defs/distribution"},
        "candidate_output_tokens": {"$ref": "#/$defs/distribution"}, "peer_output_tokens": {"$ref": "#/$defs/distribution"},
        "throughput_one_second_bins": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "resource_sample_count": {"type": "integer", "minimum": 121}, "queue_block_ns": {"$ref": "#/$defs/distribution"},
        "agreement_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "disagreement_ordinals": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 63}, "uniqueItems": true},
        "fixture_stability": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object"}},
        "stop_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "error_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "lexical_refusal_marker_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "context_buckets": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "decision_use": {"const": false}
      }
    },
    "law": {
      "type": "object", "additionalProperties": false,
      "required": ["law_id", "status", "claim_made", "meaning_source", "evidence", "metrics", "failure_code", "held_reason"],
      "properties": {
        "law_id": {"enum": ["L7", "L8", "L10", "L14", "L18"]}, "status": {"enum": ["HELD", "NOT_RUN"]},
        "claim_made": {"const": false}, "meaning_source": {"type": "string"}, "evidence": {"type": "array", "maxItems": 0},
        "metrics": {"type": "object", "maxProperties": 0}, "failure_code": {"type": "null"}, "held_reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"replica_consistency": {"properties": {"status": {"const": "MATCH"}}}}}, "then": {"properties": {"replica_consistency": {"properties": {"compared_count": {"const": 64}, "agreement_count": {"const": 64}, "mismatch_count": {"const": 0}, "mismatch_ordinals": {"maxItems": 0}, "exact_replica_consumer_stop": {"const": false}}}}}},
    {"if": {"properties": {"replica_consistency": {"properties": {"status": {"const": "MISMATCH"}}}}}, "then": {"properties": {"replica_consistency": {"properties": {"mismatch_count": {"minimum": 1}, "mismatch_ordinals": {"minItems": 1}, "exact_replica_consumer_stop": {"const": true}}}}}},
    {"if": {"properties": {"public_safety": {"properties": {"scanner_status": {"const": "BLOCKED_PUBLIC_SAFETY"}}}}}, "then": {"properties": {"export": {"properties": {"status": {"const": "BLOCKED_PUBLIC_SAFETY"}, "archive_bytes": {"type": "null"}, "archive_sha256": {"type": "null"}}}}}}
  ],
  "x-semantic-validator-required": true,
  "x-classification": "NON_SCORING_EXPLORATORY_OBSERVATION",
  "x-run-authorized": false
}
