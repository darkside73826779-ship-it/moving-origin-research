{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://moving-origin-research.invalid/schemas/executability-trace-v1",
  "title":"Three-Layer Executability Trace v1",
  "x-artifact-date":"2026-08-21",
  "x-artifact-regime":"B",
  "x-source-class":"PROPOSED",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","date","regime","specification_path","specification_sha","rows"],
  "properties":{
    "schema_version":{"const":"executability-trace-v1"},
    "date":{"type":"string","format":"date"},
    "regime":{"const":"B"},
    "specification_path":{"type":"string"},
    "specification_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "rows":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/row"}}
  },
  "$defs":{
    "row":{"type":"object","additionalProperties":false,"required":["input_id","kind","repository_path","producer_role","consumer_roles","exact_value_or_schema_source","canonicalization","expected_sha256","creation_phase","status","architect_verification_id","critic_verification_id","taskbuilder_verification_id","failure_disposition"],"properties":{
      "input_id":{"type":"string","pattern":"^[A-Z0-9_]+$"},
      "kind":{"enum":["fixture","artifact_pair","stochastic_realization","configuration","schema","ordering","digest","dependency","rng_identity","failure_injection","other"]},
      "repository_path":{"type":"string"},
      "producer_role":{"enum":["ARCHITECT","TASK_BUILDER","INTEGRATOR","RECORDER","JUDGE","REBECCA","EXTERNAL_FIXED_SOURCE"]},
      "consumer_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["ARCHITECT","CRITIC","TASK_BUILDER","INTEGRATOR","RECORDER","JUDGE","REBECCA"]}},
      "exact_value_or_schema_source":{"type":"string","minLength":1},
      "canonicalization":{"enum":["raw_utf8_lf","rfc8785","git_blob","not_applicable"]},
      "expected_sha256":{"anyOf":[{"type":"string","pattern":"^[0-9a-f]{64}$"},{"const":"not_applicable"}]},
      "creation_phase":{"enum":["specification","implementation_commit","evidence_commit","custody_publication"]},
      "status":{"enum":["READY","STOP_UNRESOLVED"]},
      "architect_verification_id":{"type":"string","minLength":1},
      "critic_verification_id":{"type":"string","minLength":1},
      "taskbuilder_verification_id":{"type":"string","minLength":1},
      "failure_disposition":{"enum":["SPECIFICATION_STOP","CRITIC_BLOCK","TASK_BUILDER_STOP","INSTRUMENT_FAILURE","NOT_APPLICABLE"]}
    }}
  }
}
