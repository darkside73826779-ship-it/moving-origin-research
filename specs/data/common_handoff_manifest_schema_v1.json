{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://moving-origin-research.invalid/schemas/common-handoff-manifest-v1",
  "title":"Common Formal Handoff Manifest v1",
  "x-artifact-date":"2026-08-21",
  "x-artifact-regime":"B",
  "x-source-class":"PROPOSED",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","date","regime","transfer_kind","work_item","gate","sender_role","receiver_role","authority_basis","remote_ref","base_sha","result_sha","work_branch","artifacts","checks_performed","status","findings","scan_attestation","next_event","prohibited_actions","role_extension"],
  "properties":{
    "schema_version":{"const":"common-handoff-manifest-v1"},
    "date":{"type":"string","format":"date"},
    "regime":{"const":"B"},
    "transfer_kind":{"const":"FORMAL_HANDOFF"},
    "work_item":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,79}$"},
    "gate":{"type":"string","minLength":1},
    "sender_role":{"enum":["WORKFLOW_COORDINATOR","ARCHITECT","CRITIC","TASK_BUILDER","INTEGRATOR","RECORDER","JUDGE","REBECCA"]},
    "receiver_role":{"enum":["WORKFLOW_COORDINATOR","ARCHITECT","CRITIC","TASK_BUILDER","INTEGRATOR","RECORDER","JUDGE","REBECCA"]},
    "authority_basis":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/repoPointer"}},
    "remote_ref":{"type":"string","pattern":"^(refs/heads/)?[A-Za-z0-9._/-]+$"},
    "base_sha":{"$ref":"#/$defs/sha"},
    "result_sha":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},
    "work_branch":{"type":"string","pattern":"^(architect|critic|taskbuilder|integrator|recorder|judge|coordinator)/[A-Za-z0-9._/-]+$"},
    "artifacts":{"type":"object","minProperties":1,"propertyNames":{"$ref":"#/$defs/repoPath"},"additionalProperties":{"$ref":"#/$defs/sha256"}},
    "checks_performed":{"type":"array","items":{"type":"string","minLength":1}},
    "status":{"enum":["READY","BLOCKED","CLEAR","VERIFIED","PENDING_REBECCA","PENDING_RECORDER_CUSTODY","UNPUBLISHED_JUDGE_RULING"]},
    "findings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["classification","severity","text"],"properties":{"classification":{"type":"string"},"severity":{"enum":["blocking","non_blocking"]},"text":{"type":"string"}}}},
    "scan_attestation":{"type":"object","additionalProperties":false,"required":["base_sha","tip_sha","tool_status","manual_review","findings"],"properties":{"base_sha":{"$ref":"#/$defs/sha"},"tip_sha":{"$ref":"#/$defs/sha"},"tool_status":{"enum":["clean","blocked","error"]},"manual_review":{"type":"boolean"},"findings":{"type":"array","items":{"type":"string"}}}},
    "next_event":{"type":"string","minLength":1},
    "prohibited_actions":{"type":"array","minItems":1,"items":{"type":"string"}},
    "role_extension":{"oneOf":[{"$ref":"#/$defs/architectExtension"},{"$ref":"#/$defs/criticExtension"},{"$ref":"#/$defs/taskBuilderExtension"},{"$ref":"#/$defs/integratorExtension"},{"$ref":"#/$defs/recorderExtension"},{"$ref":"#/$defs/judgeExtension"},{"$ref":"#/$defs/coordinatorExtension"},{"$ref":"#/$defs/rebeccaExtension"}]}
  },
  "allOf":[
    {"if":{"properties":{"sender_role":{"const":"ARCHITECT"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/architectExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"CRITIC"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/criticExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"TASK_BUILDER"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/taskBuilderExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"INTEGRATOR"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/integratorExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"RECORDER"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/recorderExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"JUDGE"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/judgeExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"WORKFLOW_COORDINATOR"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/coordinatorExtension"}}}},
    {"if":{"properties":{"sender_role":{"const":"REBECCA"}}},"then":{"properties":{"role_extension":{"$ref":"#/$defs/rebeccaExtension"}}}}
  ],
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "repoPath":{"type":"string","pattern":"^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)[A-Za-z0-9._/-]+$"},
    "repoPointer":{"type":"object","additionalProperties":false,"required":["path","sha"],"properties":{"path":{"$ref":"#/$defs/repoPath"},"sha":{"$ref":"#/$defs/sha"}}},
    "architectExtension":{"type":"object","additionalProperties":false,"required":["role","changelog_paths","diff_self_inspection"],"properties":{"role":{"const":"ARCHITECT"},"changelog_paths":{"type":"array","items":{"$ref":"#/$defs/repoPath"}},"diff_self_inspection":{"type":"boolean"}}},
    "criticExtension":{"type":"object","additionalProperties":false,"required":["role","verdict","law_fidelity","substantive"],"properties":{"role":{"const":"CRITIC"},"verdict":{"enum":["CLEAR","BLOCK","VERIFIED"]},"law_fidelity":{"enum":["PASS","BLOCK","NOT_APPLICABLE"]},"substantive":{"enum":["CLEAR","BLOCK","VERIFIED"]}}},
    "taskBuilderExtension":{"type":"object","additionalProperties":false,"required":["role","tests","diagnostics_executed"],"properties":{"role":{"const":"TASK_BUILDER"},"tests":{"type":"array","items":{"type":"string"}},"diagnostics_executed":{"type":"boolean"}}},
    "integratorExtension":{"type":"object","additionalProperties":false,"required":["role","state_sha256"],"properties":{"role":{"const":"INTEGRATOR"},"state_sha256":{"$ref":"#/$defs/sha256"}}},
    "recorderExtension":{"type":"object","additionalProperties":false,"required":["role","custody_hashes"],"properties":{"role":{"const":"RECORDER"},"custody_hashes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sha256"}}}},
    "judgeExtension":{"type":"object","additionalProperties":false,"required":["role","custody_envelope","publication_status"],"properties":{"role":{"const":"JUDGE"},"custody_envelope":{"$ref":"#/$defs/judgeEnvelope"},"publication_status":{"const":"PENDING_RECORDER_CUSTODY"}}},
    "coordinatorExtension":{"type":"object","additionalProperties":false,"required":["role","ball_recorded"],"properties":{"role":{"const":"WORKFLOW_COORDINATOR"},"ball_recorded":{"type":"boolean"}}},
    "rebeccaExtension":{"type":"object","additionalProperties":false,"required":["role","ruling_path"],"properties":{"role":{"const":"REBECCA"},"ruling_path":{"$ref":"#/$defs/repoPath"}}},
    "judgeEnvelope":{"type":"object","additionalProperties":false,"required":["schema_version","filename","media_type","encoding","byte_length","sha256","content_base64"],"properties":{"schema_version":{"const":"judge-custody-envelope-v1"},"filename":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,79}\\.md$"},"media_type":{"const":"text/markdown; charset=utf-8"},"encoding":{"const":"base64-rfc4648-no-whitespace"},"byte_length":{"type":"integer","minimum":1,"maximum":4194304},"sha256":{"$ref":"#/$defs/sha256"},"content_base64":{"type":"string","pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}}}
  }
}
